# Copie ce fichier en .env et remplis les valeurs. Ne publie jamais le fichier .env.

# Clé API Anthropic (https://console.anthropic.com), utilisée pour lire les images de partition
ANTHROPIC_API_KEY=

# Facultatif : code à donner aux choristes pour autoriser la lecture d'images
CODE_ACCES=

# Facultatif : nombre maximum d'images par heure et par personne (20 par défaut)
LIMITE_PAR_HEURE=20

# Facultatif : port du serveur (3001 par défaut)
PORT=3001
